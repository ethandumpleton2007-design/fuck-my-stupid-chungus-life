<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <dllmap dll="yoga.dll" os="windows" cpu="x64" target="lib/windows/x64/yoga.dll"/>
  <dllmap dll="yoga.dll" os="windows" cpu="arm64" target="lib/windows/arm64/yoga.dll"/>
  <dllmap dll="yoga.dll" os="osx" target="lib/osx/libyoga.dylib"/>
  <dllmap dll="yoga.dll" os="linux" cpu="x64" wordsize="64" target="lib/linux/x64/libyoga.so"/>
  <dllmap dll="yoga.dll" os="linux" cpu="arm64" wordsize="64" target="lib/linux/arm64/libyoga.so"/>
  <dllmap dll="yoga.dll" os="linux" cpu="armv8" wordsize="64" target="lib/linux/arm64/libyoga.so"/>
</configuration>
